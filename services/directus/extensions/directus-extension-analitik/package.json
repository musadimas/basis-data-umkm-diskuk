{
  "name": "directus-extension-analitik",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp -R src/* dist/ && cp src/oas.yaml dist/oas.yaml",
    "test": "node --test test/*.test.cjs test/*.integration.test.cjs",
    "test:exports": "node --test test/index.test.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ioredis": "^5.8.2"
  }
}
