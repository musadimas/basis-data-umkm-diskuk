# Build the tracked extensions from their sources, then run the pinned Directus image.
FROM node:20-alpine AS builder
RUN apk add --no-cache python3 g++ make bash postgresql-client \
    && corepack enable \
    && corepack prepare pnpm@9.15.9 --activate
WORKDIR /directus
RUN npm init -y && npm install --no-save argon2
COPY services/directus/extensions /directus/extensions
COPY services/directus/migrations /directus/migrations
COPY services/directus/package.json services/directus/pnpm-lock.yaml /directus/service-package/
COPY scripts/refresh-dashboard-snapshots.sql /directus/scripts/refresh-dashboard-snapshots.sql
RUN cd /directus/extensions/directus-extension-infografis && pnpm run build
RUN cd /directus/extensions/directus-extension-tabular && pnpm run build \
    && cp /directus/scripts/refresh-dashboard-snapshots.sql dist/publish.sql
# The docs extension has its own lockfile and TypeScript build.
RUN cd /directus/extensions/docs && pnpm install --frozen-lockfile && pnpm run build
RUN cd /directus/extensions/directus-extension-analytics-watchdog && pnpm run build
RUN cd /directus/extensions/directus-extension-analitik && pnpm run build

FROM directus/directus:11.17.4
USER root
RUN apk add --no-cache postgresql-client bash
COPY --from=builder /directus/node_modules /directus/node_modules
COPY --from=builder /directus/extensions /directus/extensions
COPY --from=builder /directus/migrations /directus/migrations
COPY --from=builder /directus/scripts /directus/scripts
COPY services/directus/templates /directus/templates
COPY services/directus/init.sh /usr/local/bin/init.sh
RUN sed -i 's/\r$//' /usr/local/bin/init.sh && chmod +x /usr/local/bin/init.sh \
    && mkdir -p /var/lib/directus/analytics-exports \
    && chown -R node:node /var/lib/directus/analytics-exports
USER node
ENTRYPOINT ["/usr/local/bin/init.sh"]
