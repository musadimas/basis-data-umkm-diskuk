{
  "name": "@diskuk/directus",
  "version": "1.0.0",
  "description": "Directus service for DISKUK directus \u2014 monitoring service and operational content.",
  "private": true,
  "type": "module",
  "author": "slaint",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.5.0"
  },
  "scripts": {
    "dev": "directus start",
    "start": "directus start",
    "dbi": "directus database install",
    "dbm:u": "directus database migrate:up",
    "dbm:d": "directus database migrate:down",
    "dbm:l": "directus database migrate:latest",
    "sch:s": "directus schema snapshot ./snapshots/snapshot.yaml",
    "sch:a": "directus schema apply ./snapshots/snapshot.yaml",
    "clean": "rm -rf node_modules pnpm-lock.yaml",
    "docker": "docker compose -f D:/Docker/directus/docker-compose.yml --env-file ./.env -p diskuk-directus up -d",
    "docker:down": "docker compose -f D:/Docker/directus/docker-compose.yml --env-file ./.env -p diskuk-directus down",
    "docker:latest": "docker compose -f D:/Docker/directus/docker-compose.yml --env-file ./.env -p diskuk-directus pull && docker compose -f D:/Docker/directus/docker-compose.yml --env-file ./.env -p diskuk-directus up -d",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "directus": "11.17.4"
  }
}
