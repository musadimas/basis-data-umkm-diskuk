diskuk.tangkassiskamling.com {
	# Arsip PMTiles mengandung lokasi usaha rinci. Otorisasi setiap request Range
	# melalui guard dashboard, lalu biarkan MinIO melayani byte range-nya.
	handle_path /tiles/* {
		route {
			forward_auth web:3000 {
				uri /panel/v1/analytics/tabular/spasial/authorize
			}
			header -Access-Control-Allow-Origin
			header Cache-Control "private, no-store"
			rewrite * /{$ANALYTICS_EXPORT_BUCKET}/spatial-tiles{path}
			reverse_proxy minio:9000
		}
	}

	reverse_proxy web:3000
}
