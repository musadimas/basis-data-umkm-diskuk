diskuk.tangkassiskamling.com {
    # Arsip PMTiles titik UMKM (prefix spatial-tiles pada bucket ekspor) disajikan
    # langsung dari MinIO; PMTiles hanya butuh dukungan HTTP Range yang sudah
    # disediakan MinIO. Baca anonim diizinkan karena koordinat & nama usaha
    # bukan PII (ADR-0004); kebijakan anonim dipasang oleh build-spatial-tiles.sh.
    handle_path /tiles/* {
        header Access-Control-Allow-Origin *
        header Cache-Control "public, max-age=3600"
        rewrite * /{$ANALYTICS_EXPORT_BUCKET}/spatial-tiles{path}
        reverse_proxy minio:9000
    }

    reverse_proxy web:3000
}
