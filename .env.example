# Local/ephemeral placeholders only. Replace through a secret manager for deployment.
DB_USER=diskuk_app
DB_PASSWORD=change-me-local
DB_DATABASE=diskuk
DIRECTUS_SECRET=change-me-directus-secret
DIRECTUS_ADMIN_EMAIL=admin@example.invalid
DIRECTUS_ADMIN_PASSWORD=change-me-admin-password
DIRECTUS_PUBLIC_URL=http://127.0.0.1:8055
DIRECTUS_STORAGE_ACCESS_KEY=diskuk-storage-local
DIRECTUS_STORAGE_SECRET_KEY=change-me-storage-secret
ANALYTICS_EXPORT_ACCESS_KEY=diskuk-export-local
ANALYTICS_EXPORT_SECRET_KEY=change-me-export-secret
MINIO_ROOT_USER=diskuk-bootstrap
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_BUCKET=diskuk
ANALYTICS_EXPORT_BUCKET=diskuk-exports
# Directus address the web proxies /panel/** to (read when the web image is built).
PANEL_URL=http://directus:8055
DEMO_MODE=false
DEMO_DISPOSABLE=false
# SSO Jabar: isi hanya setelah kontrak IdP, akun terpetakan, dan redirect allow-list tersedia.
SSO_JABAR_ENABLED=false
# SSO_WEB_ORIGIN=https://dashboard.example.invalid
# AUTH_PROVIDERS=jabar
# AUTH_JABAR_DRIVER=openid
# AUTH_JABAR_ISSUER_URL=https://idp.example.invalid/.well-known/openid-configuration
# AUTH_JABAR_CLIENT_ID=
# AUTH_JABAR_CLIENT_SECRET=
# AUTH_JABAR_ALLOW_PUBLIC_REGISTRATION=false
# AUTH_JABAR_MODE=session
# AUTH_JABAR_REDIRECT_ALLOW_LIST=https://dashboard.example.invalid/sso-complete
SESSION_COOKIE_SECURE=false
DIRECTUS_SESSION_COOKIE_NAME=diskuk_session
ANALYTICS_DATABASE_URL=postgres://diskuk_app:change-me-local@postgis:5432/diskuk
ANALYTICS_TEST_DATABASE_URL=postgres://diskuk_app:change-me-local@127.0.0.1:5432/diskuk
APPLICATION_USER_EMAIL=application-user@example.invalid
APPLICATION_USER_PASSWORD=change-me-application-password
ANALYTICS_WORKER_POLL_MS=1000
ANALYTICS_WORKER_CONCURRENCY=2
ANALYTICS_WORKER_LEASE_SECONDS=120
ANALYTICS_REDIS_URL=redis://redis:6379/0
ANALYTICS_REDIS_TTL_SECONDS=300

ANALYTICS_EXPORT_DIR=/var/lib/directus/analytics-exports
BACKUP_S3_ENDPOINT=https://replace-with-offhost-s3.example.invalid

# Dashboard operasional (fase Y01)
OPERASIONAL_INTERNAL_SECRET=change-me-operasional-internal-secret
# Pembatasan percobaan per IP (proteksi brute-force login)
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=60
RATE_LIMITER_DURATION=10s

# Klinik konsultasi (fase Y08). Provider WhatsApp belum ditetapkan: biarkan WHATSAPP_GATEWAY_URL
# kosong sampai ada gateway/sandbox. Selama kosong, antrean notifikasi tetap `pending` dan API
# melaporkan "not provider-proven" — bukan mengklaim pesan terkirim.
# WHATSAPP_GATEWAY_URL=https://sandbox.provider.invalid/messages
# WHATSAPP_GATEWAY_TOKEN=
# WHATSAPP_GATEWAY_PROVIDER=http
# WHATSAPP_SENDER=
# "true" = 2xx berarti provider menerima pesan; resi callback menentukan status "diterima".
WHATSAPP_REQUIRE_CALLBACK=true
# Rahasia callback resi (POST /v1/program/klinik/notifikasi/receipt); kosong = fallback OPERASIONAL_INTERNAL_SECRET.
# WHATSAPP_RECEIPT_SECRET=
# Interval publisher antrean, milidetik.
WHATSAPP_DISPATCH_MS=60000

# Pengingat agenda (fase Y07). Kanal email memakai mailer Directus di atas (Mailpit pada stack
# disposable, SMTP relay saat deploy); kanal WhatsApp memakai WHATSAPP_GATEWAY_* yang sama seperti
# klinik. Selama gateway kosong, opt-in WhatsApp langsung berstatus `menunggu_gateway` dan tidak
# pernah diklaim terkirim. Job pengingat juga dapat dijalankan manual lewat
# POST /v1/program/kegiatan/pengingat/proses dengan header x-operasional-internal-secret.

# Authentication
AUTH_CAPTCHA_ENFORCE=true
AUTH_CAPTCHA_COST=5000
# Origins that may log in without a captcha (the Data Studio): comma list, or "none".
# Leave unset to use PUBLIC_URL's origin; keep "none" when the web and Directus share an origin.
AUTH_CAPTCHA_EXEMPT_ORIGINS=none
# Session policy (ADR-001): idle timeout and absolute lifetime, e.g. 30m / 8h.
AUTH_SESSION_IDLE_TIMEOUT=30m
AUTH_SESSION_MAX_AGE=8h
# CSRF: origins (web app, Data Studio) that may change data with the session cookie.
# Empty = DIRECTUS_PUBLIC_URL's origin; list both when the web and Directus differ.
AUTH_ALLOWED_ORIGINS=
# Optional; derived from DIRECTUS_SECRET when empty.
ALTCHA_HMAC_SECRET=
# Web password reset page (also used as PASSWORD_RESET_URL_ALLOW_LIST).
AUTH_PASSWORD_RESET_URL=http://127.0.0.1:3000/reset-kata-sandi
# Local mailer: the mailpit sandbox from docker-compose (web UI/API on http://127.0.0.1:8025).
EMAIL_FROM=no-reply@diskuk.jabarprov.go.id
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
# Production alternative: a real SMTP relay. Uncomment and fill in when deploying.
# EMAIL_SMTP_HOST=smtp.example.invalid
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_SECURE=false

# Talent Passport Ed25519 private key (base64 of the PEM):
#   openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
# kid identifies the active signing key (default: fingerprint of the public key).
# PASSPORT_SIGNING_PRIVATE_KEY_PREVIOUS_B64 keeps the previous key verifying during rotation.
PASSPORT_SIGNING_PRIVATE_KEY_B64=
PASSPORT_SIGNING_KID=
PASSPORT_SIGNING_PRIVATE_KEY_PREVIOUS_B64=
PASSPORT_SIGNING_KID_PREVIOUS=
