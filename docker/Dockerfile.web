FROM node:22-alpine AS builder

ARG NUXT_PUBLIC_PANEL_URL
ENV NUXT_PUBLIC_PANEL_URL=$NUXT_PUBLIC_PANEL_URL

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
COPY apps/web/.npmrc ./

RUN pnpm install --frozen-lockfile

COPY apps/web/ ./

# apps/web/pnpm-workspace.yaml only carries pnpm 10 "allowBuilds" settings for
# local development. It has no "packages" field, which makes pnpm treat /app as
# a broken workspace root and abort `pnpm run` with "packages field missing or
# empty". Drop it before running the build.
RUN rm -f pnpm-workspace.yaml && pnpm run build

FROM node:22-alpine

WORKDIR /app

COPY --from=builder /app/.output ./.output

EXPOSE 3000
ENV HOST=0.0.0.0

CMD ["node", ".output/server/index.mjs"]
